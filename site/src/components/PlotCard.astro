---
interface Props {
  title: string;
  src: string;
  alt: string;
  summary: string;
}

const { title, src, alt, summary } = Astro.props;
---

<figure class="plot-card">
  <img loading="lazy" src={src} alt={alt} />
  <figcaption class="plot-card-copy">
    <p class="eyebrow">Figure</p>
    <h3>{title}</h3>
    <p>{summary}</p>
  </figcaption>
</figure>
