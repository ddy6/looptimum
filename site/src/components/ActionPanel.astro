---
interface Props {
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
}

const {
  title,
  body,
  primaryHref,
  primaryLabel,
} = Astro.props;
---

<section class="action-panel">
  <div>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <div class="hero-actions">
    <a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
  </div>
</section>
