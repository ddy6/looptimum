---
interface Props {
  title: string;
  dek: string;
  spacedBelow?: boolean;
}

const {
  title,
  dek,
  spacedBelow = false,
} = Astro.props;
---

<section class={spacedBelow ? "page-hero page-hero-spaced" : "page-hero"}>
  <div class="page-hero-inner">
    <h1>{title}</h1>
    <p class="dek">{dek}</p>
  </div>
</section>
