---
import ActionPanel from "../../components/ActionPanel.astro";
import MetricCard from "../../components/MetricCard.astro";
import PageHero from "../../components/PageHero.astro";
import PlotCard from "../../components/PlotCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies, repoLinks } from "../../data/site";

const campaign = caseStudies.find((item) => item.slug === "gpt-training");
if (!campaign) {
  throw new Error("Missing anonymized GPT case-study data");
}
---

<BaseLayout
  title="Anonymized GPT Training Campaign | Looptimum"
  description="An anonymized ten-evaluation GPT training search found 1.02% lower held-out loss and about 25% fewer parameters than a fixed baseline."
  currentPath="/evidence/gpt-training/"
>
  <PageHero
    title="GPT training-parameter search"
    dek="An anonymized campaign tested four training controls, starting with four deterministic evaluations and following with six guided trials. All ten ran in the existing training environment."
  />

  <div class="stack-lg">
    <section class="metric-grid metric-grid-three" aria-label="Observed campaign results">
      <h2 class="sr-only">Observed campaign results</h2>
      {campaign.metrics.map((metric) => (
        <MetricCard {...metric} />
      ))}
    </section>

    <section class="proof-banner reveal" aria-labelledby="result-boundary-heading">
      <h2 id="result-boundary-heading">Observed results</h2>
      <p>
        The selected model's held-out loss index was 98.98 against a fixed
        baseline of 100.00. Its parameter-count index was 75.4 against 100.0.
        This single-seed, small-budget campaign does not establish statistical
        significance or global optimality.
      </p>
    </section>

    <section class="two-column" aria-label="Campaign method">
      <div class="feature-panel reveal">
        <h2>Search parameters</h2>
        <p>
          The search varied four controls within defined bounds. All ten
          evaluations completed successfully.
        </p>
        <div class="pill-row" aria-label="Bounded recipe controls">
          <span class="pill">Learning rate</span>
          <span class="pill">Microbatch size</span>
          <span class="pill">Gradient accumulation</span>
          <span class="pill">Model depth</span>
        </div>
      </div>
      <div class="feature-panel reveal">
        <h2>Evaluation method</h2>
        <p>
          Looptimum proposed the settings, and the client-owned training
          workflow returned a loss index measured on the fixed held-out data.
          The controller recorded the result before choosing the next trial.
        </p>
        <a class="inline-link" href={repoLinks.gptCaseStudy}>Read the public evidence <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="plot-grid" aria-label="Normalized campaign figures">
      <h2 class="sr-only">Normalized campaign figures</h2>
      {campaign.proofAssets.map((asset) => (
        <PlotCard {...asset} />
      ))}
    </section>

    <section class="evidence-list reveal" aria-labelledby="trajectory-heading">
      <h2 id="trajectory-heading">Search progression</h2>
      <ul>
        <li>The guided phase found the two strongest observed candidates, with loss indices of 99.10 and 98.98.</li>
        <li>Later trials explored the remaining bounds without improving that result.</li>
        <li>This campaign does not establish a general advantage of guided over random search.</li>
      </ul>
    </section>

    <section class="proof-banner reveal" aria-labelledby="limitations-heading">
      <h2 id="limitations-heading">Limits of this result</h2>
      <ul>
        <li>One seed and ten evaluations do not establish statistical significance.</li>
        <li>The selected model was the best observed; global optimality was not established.</li>
        <li>The search does not isolate the causal effect of any one control.</li>
        <li>Transfer to another workflow, broader model quality, and production readiness were not assessed.</li>
        <li>About 25% fewer parameters does not imply a matching reduction in runtime or cost.</li>
      </ul>
    </section>

    <ActionPanel
      title="Model-training pilot assessment"
      body="A project review covers the adjustable training parameters, evaluation metric, and resource cost per run."
      primaryHref={campaign.cta.href}
      primaryLabel={campaign.cta.label}
    />
  </div>
</BaseLayout>
