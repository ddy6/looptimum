---
import ActionPanel from "../../components/ActionPanel.astro";
import MetricCard from "../../components/MetricCard.astro";
import PageHero from "../../components/PageHero.astro";
import PlotCard from "../../components/PlotCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies, heroMetrics, repoLinks, validationChecks } from "../../data/site";

const campaign = caseStudies.find((item) => item.slug === "engineering-mesh");
if (!campaign) {
  throw new Error("Missing engineering mesh case-study data");
}
---

<BaseLayout
  title="Validated Engineering Mesh Campaign | Looptimum"
  description="A 21-trial mesh search reduced cell count by 72.9% and solver time by 91.0%, with separate flow, pressure, and mesh-independence checks."
  currentPath="/evidence/engineering-mesh/"
>
  <PageHero
    title="Finding a smaller simulation mesh"
    dek="Looptimum tested 21 configurations in a 216-point search space. The selected coarse mesh was then checked against a trusted fine reference in a separate solver pass."
  />

  <div class="stack-lg">
    <section class="metric-grid" aria-label="Validated campaign results">
      <h2 class="sr-only">Validated campaign results</h2>
      {heroMetrics.map((metric) => (
        <MetricCard {...metric} />
      ))}
    </section>

    <section class="two-column" aria-label="Campaign method">
      <div class="feature-panel reveal">
        <h2>The engineering problem</h2>
        <p>
          The fine mesh produced reliable pressure and flow results but took
          weeks to solve. The aim was to find a smaller, stable mesh that
          preserved those results at a lower computational cost.
        </p>
      </div>
      <div class="feature-panel reveal">
        <h2>How the search ran</h2>
        <p>
          Looptimum proposed mesh-control settings and recorded the outcomes.
          Existing meshing and checkMesh workflows evaluated each trial; the
          solver and mesh-independence checks established final acceptance.
        </p>
        <a class="inline-link" href={repoLinks.caseStudy}>Read the public evidence <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="plot-grid" aria-label="Engineering campaign figures">
      <h2 class="sr-only">Engineering campaign figures</h2>
      {campaign.proofAssets.map((asset) => (
        <PlotCard {...asset} />
      ))}
    </section>

    <section class="two-column" aria-label="Campaign record and validation">
      <div class="evidence-list reveal">
        <h2>Search record</h2>
        <ul>
          <li>8 random starts, then 13 surrogate-guided suggestions</li>
          <li>Selected candidate's archived objective loss: 9.0</li>
          <li>One failed checkMesh outcome retained in the record</li>
          <li>Final acceptance based on solver and mesh-independence checks</li>
        </ul>
      </div>
      <div class="evidence-list reveal">
        <h2>Acceptance checks</h2>
        <ul>
          {validationChecks.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="proof-banner reveal" aria-labelledby="engineering-limitations-heading">
      <h2 id="engineering-limitations-heading">Limits of this result</h2>
      <ul>
        <li>The selected mesh passed this campaign's checks; global optimality was not established.</li>
        <li>Savings are measured against the archived fine reference, geometry, and workflow.</li>
        <li>Searching fewer than 10% of this space does not guarantee similar efficiency elsewhere.</li>
        <li>The objective score alone was insufficient for acceptance; a separate solver pass was required.</li>
        <li>Other geometries, solver settings, or acceptance thresholds need their own validation.</li>
      </ul>
    </section>

    <ActionPanel
      title="Have a similar workflow?"
      body="Tell us about your evaluator and the checks a useful result would need to pass."
      primaryHref={campaign.cta.href}
      primaryLabel={campaign.cta.label}
    />
  </div>
</BaseLayout>
