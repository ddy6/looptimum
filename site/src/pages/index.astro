---
import ActionPanel from "../components/ActionPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  caseStudies,
  repoLinks,
  useCases,
  workflowSteps,
} from "../data/site";
---

<BaseLayout
  title="Looptimum | Black-Box Optimization for Expensive Evaluations"
  description="Looptimum is a lightweight black-box optimization controller that uses previous results to choose which expensive evaluation to run next."
  currentPath="/"
>
  <section id="core-looptimum" class="page-hero">
    <div class="hero-grid hero-grid-focused">
      <div class="hero-copy">
        <h1>Run fewer expensive trials.</h1>
        <p class="dek">
          Looptimum uses completed results to choose what to try next. Your
          evaluations run in your own environment, and the search can resume
          after interruptions.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/evidence/">Read the case studies</a>
        </div>
        <div class="loop-notation" aria-label="Looptimum workflow: suggest, evaluate, ingest, repeat">
          <span>suggest</span>
          <span aria-hidden="true">→</span>
          <span>evaluate</span>
          <span aria-hidden="true">→</span>
          <span>ingest</span>
          <span aria-hidden="true">↺</span>
        </div>
      </div>
    </div>
  </section>

  <div class="stack-lg">
    <section class="stack-md">
      <section class="two-column">
        <div class="section-head">
          <h2>How it works</h2>
          <p>
            Set the parameters you can change and the score you want to improve.
            Looptimum proposes a trial; your existing workflow runs it.
          </p>
        </div>
        <ol class="workflow-list">
          {workflowSteps.map((step, index) => (
            <li class="workflow-item">
              <span class="workflow-number">0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="homepage-evidence-preview" aria-labelledby="evidence-preview-heading">
        <h2 id="evidence-preview-heading" class="sr-only">Campaign evidence examples</h2>
        <div class="case-study-grid evidence-preview-grid">
          {caseStudies.map((caseStudy) => (
            <article class="case-study-card evidence-preview-card">
              <div class="case-study-card-media">
                <img
                  src={caseStudy.proofAssets[0].src}
                  alt={caseStudy.proofAssets[0].alt}
                  loading="lazy"
                />
              </div>
              <div class="case-study-card-copy">
                <h3>{caseStudy.title}</h3>
                <p>{caseStudy.summary}</p>
                <a class="inline-link" href={caseStudy.href}>
                  Read the case study <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="section-head">
        <h2>Where it helps</h2>
        <p>
          Start with a working evaluator, a few adjustable parameters, and a
          real cost to every run.
        </p>
      </div>
      <div class="use-case-grid">
        {useCases.map((item) => (
          <article class="use-case-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="larc-callout" aria-labelledby="larc-callout-heading">
      <div>
        <h2 id="larc-callout-heading">Before you have an evaluation loop</h2>
        <p>
          The Looptimum Advanced Research Collective (LARC) works on early
          technical projects where computing costs, experiment design, or
          system architecture still need to be worked out.
        </p>
      </div>
      <div class="larc-callout-action">
        <p>
          LARC helps define what to build and test first.
        </p>
        <a class="inline-link" href="/larc/">Read about LARC <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <ActionPanel
      title="Work with Looptimum"
      body="Tell us what one run costs, what you can change, and what you want to improve."
      primaryHref="/pilot/"
      primaryLabel="Discuss a pilot"
    />

    <section id="people" class="people-section" aria-labelledby="people-heading">
      <figure class="person-portrait">
        <img
          src="/people/david-y.jpg"
          alt="Portrait of David Y."
          width="720"
          height="720"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <article class="person-profile">
        <h2 id="people-heading">David Y.</h2>
        <p class="person-role">Founder, Developer</p>
        <p class="person-biography">
          David is the founder and lead developer of Looptimum. His work spans
          computational hemodynamics, medical-device research, Bayesian
          optimization, and machine learning, including language-model
          development. He builds research software for simulation, statistical
          analysis, model calibration, and experiments. At Looptimum, he focuses
          on making costly evaluations more useful while keeping the
          underlying science and engineering sound.
        </p>
        <a class="inline-link" href={repoLinks.maintainer}>
          View GitHub profile <span aria-hidden="true">→</span>
        </a>
      </article>
    </section>
  </div>
</BaseLayout>
