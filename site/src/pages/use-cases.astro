---
import ActionPanel from "../components/ActionPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { repoLinks, useCases } from "../data/site";
---

<BaseLayout
  title="Applications | Looptimum"
  description="Parameter optimization for simulations, infrastructure, model training, and operational processes, with practical criteria for project fit."
  currentPath="/use-cases/"
>
  <PageHero
    title="Applications"
    dek="Looptimum supports parameter searches in simulation, computing, and experimental workflows. It is suited to projects with defined operating limits and evaluations that require significant time or resources."
    spacedBelow={true}
  />

  <div class="stack-lg">
    <section class="use-case-grid" aria-labelledby="use-case-list-heading">
      <h2 id="use-case-list-heading" class="sr-only">Representative use cases</h2>
      {useCases.map((item) => (
        <article class="use-case-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.href && item.linkLabel && (
            <a class="inline-link" href={item.href}>{item.linkLabel} <span aria-hidden="true">→</span></a>
          )}
        </article>
      ))}
    </section>

    <section class="two-column">
      <div class="feature-panel">
        <h2>Project suitability</h2>
        <p>
          Start with an evaluator your team already runs. Identify the
          parameters you can change, the score you want to improve, and the
          cost of one evaluation.
        </p>
        <a class="inline-link" href={repoLinks.pilot}>Read the pilot scope notes <span aria-hidden="true">→</span></a>
      </div>
      <div class="criteria-grid">
        <article class="criteria-card">
          <h3>Defined parameters</h3>
          <p>A manageable set of numeric or discrete controls with clear limits.</p>
        </article>
        <article class="criteria-card">
          <h3>Expensive evaluations</h3>
          <p>Runs where saving time, compute, or materials would matter to the project.</p>
        </article>
        <article class="criteria-card">
          <h3>Repeatable execution</h3>
          <p>A script, solver, or workflow that can run a candidate and report its result.</p>
        </article>
        <article class="criteria-card">
          <h3>Traceability</h3>
          <p>Requirements to retain search history, review decisions, or resume interrupted work.</p>
        </article>
      </div>
    </section>

    <section class="proof-banner">
      <h2>Alternative approaches</h2>
      <ul>
        <li>Evaluations are cheap enough for random or grid search.</li>
        <li>Reliable gradients make direct gradient-based optimization practical.</li>
        <li>You cannot yet define a score that measures a useful result.</li>
        <li>There are too many variables for a bounded search to be practical.</li>
      </ul>
    </section>

    <ActionPanel
      title="Case studies"
      body="The documented campaigns cover simulation-mesh optimization and model-training parameters, including validation and limitations."
      primaryHref="/evidence/"
      primaryLabel="Read the case studies"
    />
  </div>
</BaseLayout>
