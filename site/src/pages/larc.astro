---
import ActionPanel from "../components/ActionPanel.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { larcMethodSteps, larcProjectArchetypes, siteConfig } from "../data/site";
---

<BaseLayout
  title="LARC | Looptimum Advanced Research Collective"
  description="The Looptimum Advanced Research Collective explores technical feasibility, system design, and experiment planning for early research projects."
  currentPath="/larc/"
>
  <PageHero
    title="Research and feasibility"
    dek="The Looptimum Advanced Research Collective (LARC) works with early technical projects to assess system design, computing requirements, and experimental feasibility. The scope reflects the questions that need to be resolved before implementation."
    spacedBelow={true}
  />

  <div class="stack-lg">
    <section class="two-column" aria-label="LARC and core Looptimum">
      <div class="feature-panel reveal">
        <h2>Technical assessment</h2>
        <p>
          LARC helps identify the constraints, design choices, and tests that
          determine feasibility. The assessment identifies gaps in the
          available evidence and defines experiments to address them.
        </p>
      </div>
      <div class="feature-panel reveal">
        <h2>Existing evaluation loops</h2>
        <p>
          If you already have an evaluator that accepts parameters and returns
          a score, core Looptimum can choose what to try next while your team
          continues to run the evaluations.
        </p>
        <a class="inline-link" href="/#core-looptimum">See core Looptimum <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="stack-md" aria-labelledby="larc-projects-heading">
      <div class="section-head">
        <h2 id="larc-projects-heading">Research areas</h2>
      </div>
      <div class="use-case-grid">
        {larcProjectArchetypes.map((item) => (
          <article class="use-case-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="stack-md" aria-labelledby="larc-method-heading">
      <div class="section-head">
        <h2 id="larc-method-heading">Project approach</h2>
        <p>
          The work proceeds from a review of requirements and constraints to
          an evaluation plan, with validation criteria agreed for each project.
        </p>
      </div>
      <div class="larc-method-grid">
        {larcMethodSteps.map((step, index) => (
          <article class="step-card">
            <p class="eyebrow">Step {index + 1}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="two-column">
      <div class="evidence-list reveal">
        <h2>Potential deliverables</h2>
        <ul>
          <li>A system breakdown and bottleneck analysis</li>
          <li>A plan for optimization, constraints, and evaluation</li>
          <li>Models, benchmarks, or a sequence of prototypes</li>
          <li>Validation criteria and measurable milestones</li>
          <li>A technical plan for the next stage of implementation</li>
        </ul>
      </div>
      <div class="evidence-list reveal">
        <h2>Current stage</h2>
        <p>
          LARC is an exploratory initiative, beginning with a small number of
          technical conversations and collaborations. There is no standing
          membership program or fixed service package; the scope follows the
          needs of each project.
        </p>
      </div>
    </section>

    <ActionPanel
      title="Research inquiries"
      body="Share the project context, current stage of development, and technical questions you need to resolve."
      primaryHref={siteConfig.larcContactHref}
      primaryLabel="Discuss a project"
    />
  </div>
</BaseLayout>
