---
import ActionPanel from "../components/ActionPanel.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/site";
---

<BaseLayout
  title="Evidence | Looptimum"
  description="Engineering and GPT training case studies with recorded results, validation checks, and the limits of each campaign."
  currentPath="/evidence/"
>
  <PageHero
    title="Case studies"
    dek="Two documented searches: a smaller simulation mesh checked against a fine reference, and an anonymized GPT training campaign with ten evaluations."
    spacedBelow={true}
  />

  <div class="stack-lg">
    <section class="stack-md" aria-labelledby="case-study-heading">
      <h2 id="case-study-heading" class="sr-only">Engineering and model-training campaigns</h2>
      <div class="case-study-grid">
        {caseStudies.map((caseStudy) => (
          <article class="case-study-card">
            <div class="case-study-card-media">
              <img
                src={caseStudy.proofAssets[0].src}
                alt={caseStudy.proofAssets[0].alt}
                loading="lazy"
              />
            </div>
            <div class="case-study-card-copy">
              <h3>{caseStudy.title}</h3>
              <p>{caseStudy.summary}</p>
              <div class="case-study-metrics" aria-label={`${caseStudy.title} highlights`}>
                {caseStudy.metrics.map((metric) => (
                  <span><strong>{metric.value}</strong> {metric.label}</span>
                ))}
              </div>
              <p class="case-study-note">{caseStudy.limitations[0]}</p>
              <a class="inline-link" href={caseStudy.href}>Read the case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <ActionPanel
      title="Plan a pilot"
      body="Start with one evaluation loop, a measurable objective, and a small set of parameters."
      primaryHref="/pilot/"
      primaryLabel="Discuss a pilot"
    />
  </div>
</BaseLayout>
