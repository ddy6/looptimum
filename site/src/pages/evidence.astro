---
import ActionPanel from "../components/ActionPanel.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/site";
---

<BaseLayout
  title="Evidence | Looptimum"
  description="Evidence from bounded black-box optimization campaigns, with downstream validation and explicit limitations."
  currentPath="/evidence/"
>
  <PageHero
    eyebrow="Case studies"
    title="Results are only useful when their evidence boundary is clear."
    dek="Explore documented engineering and model-training campaigns. Each case separates the observed outcome, the validation performed, and the limits on what the result establishes."
    spacedBelow={true}
    primaryHref="#case-study-heading"
    primaryLabel="Read the case studies"
    secondaryHref="/pilot/"
    secondaryLabel="Discuss a pilot"
  />

  <div class="stack-lg">
    <section class="stack-md" aria-labelledby="case-study-heading">
      <div class="section-head">
        <p class="eyebrow">Two campaign records</p>
        <h2 id="case-study-heading">Two applications, with distinct evidence boundaries.</h2>
        <p>
          The engineering example includes downstream physical validation. The
          anonymized ML example demonstrates a compact guided training-recipe
          campaign and is presented with its small-budget limitations.
        </p>
      </div>
      <div class="case-study-grid">
        {caseStudies.map((caseStudy) => (
          <article class="case-study-card">
            <div class="case-study-card-media">
              <img
                src={caseStudy.proofAssets[0].src}
                alt={caseStudy.proofAssets[0].alt}
                loading="lazy"
              />
            </div>
            <div class="case-study-card-copy">
              <p class="eyebrow">{caseStudy.eyebrow}</p>
              <h3>{caseStudy.title}</h3>
              <p>{caseStudy.summary}</p>
              <div class="case-study-metrics" aria-label={`${caseStudy.title} highlights`}>
                {caseStudy.metrics.map((metric) => (
                  <span><strong>{metric.value}</strong> {metric.label}</span>
                ))}
              </div>
              <p class="case-study-note">{caseStudy.limitations[0]}</p>
              <a class="inline-link" href={caseStudy.href}>Read the case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <ActionPanel
      title="Have an expensive evaluator of your own?"
      body="Review how the controller works, then decide whether a bounded and auditable campaign fits your workflow."
      primaryHref="/pilot/"
      primaryLabel="Discuss a pilot"
      secondaryHref="/how-it-works/"
      secondaryLabel="See how the loop runs"
    />
  </div>
</BaseLayout>
