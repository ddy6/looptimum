---
import ActionPanel from "../components/ActionPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { repoLinks, workflowSteps } from "../data/site";
---

<BaseLayout
  title="How It Works | Looptimum"
  description="Looptimum chooses the next trial, your existing workflow runs it, and the results stay in local files you can review and resume."
  currentPath="/how-it-works/"
>
  <PageHero
    title="How Looptimum works"
    dek="Looptimum chooses the next trial. Your existing workflow runs it and returns a score or a failure. Each result informs the next choice."
    spacedBelow={true}
  />

  <div class="stack-lg">
    <section aria-labelledby="workflow-heading">
      <h2 id="workflow-heading" class="sr-only">Suggest, evaluate, and ingest workflow</h2>
      <ol class="workflow-list workflow-list-wide">
        {workflowSteps.map((step, index) => (
          <li class="workflow-item">
            <span class="workflow-number">0{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="two-column">
      <div class="section-head">
        <h2>Working in your environment</h2>
        <p>
          The controller keeps its state and decision history in local files.
          You can inspect the record, resume after interruptions, and work in
          restricted environments.
        </p>
        <a class="inline-link" href={repoLinks.repo}>Read the code <span aria-hidden="true">→</span></a>
      </div>
      <div class="criteria-grid">
        <article class="criteria-card">
          <h3>Local state</h3>
          <p>
            Results, trial manifests, and suggestion logs are saved as files
            you can inspect and carry between runs.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Evaluator interface</h3>
          <p>
            The evaluator accepts parameters within defined bounds and returns
            a single score or an explicit failure.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Failed runs</h3>
          <p>
            Failures and timeouts are recorded with their reasons, so they
            remain part of the campaign history.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Decision trace</h3>
          <p>
            Suggestion logs preserve the context for each choice and the
            observations available at the time.
          </p>
        </article>
      </div>
    </section>

    <section class="stack-md" aria-labelledby="decision-boundaries-heading">
      <div class="section-head">
        <h2 id="decision-boundaries-heading">Constraints, scores, and failures</h2>
        <p>
          Define which candidates are allowed, how successful runs are scored,
          and how failures are reported.
        </p>
      </div>
      <div class="criteria-grid decision-grid">
        <article class="criteria-card">
          <h3>Hard constraints</h3>
          <p>
            Parameter bounds and feasibility rules filter candidates before
            they are suggested.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Objective score</h3>
          <p>
            A single score ranks valid candidates. If several measurements
            matter, define how they combine into that score.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Failure outcomes</h3>
          <p>
            A failed or timed-out evaluation is recorded as a completed failure
            with a reason, separately from successful measurements.
          </p>
        </article>
      </div>
    </section>

    <section class="proof-banner">
      <h2>What you need to start</h2>
      <ul>
        <li>An evaluation costly enough that choosing the next run carefully matters.</li>
        <li>A score that measures the result you want to improve.</li>
        <li>A manageable set of parameters with defined bounds.</li>
        <li>A repeatable way to run a trial and return a score or failure.</li>
      </ul>
    </section>

    <ActionPanel
      title="See it in practice"
      body="The case studies document the search, results, and validation in engineering and model training."
      primaryHref="/evidence/"
      primaryLabel="Read the case studies"
    />
  </div>
</BaseLayout>
