---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not Found | Looptimum"
  description="The requested page does not exist on the Looptimum site."
  currentPath="/404/"
>
  <section class="page-hero">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="dek">
      This address doesn't match a page. Use the navigation above or return home.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/">Go home</a>
    </div>
  </section>
</BaseLayout>
