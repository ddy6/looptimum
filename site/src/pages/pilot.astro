---
import ActionPanel from "../components/ActionPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { intakeQuestions, repoLinks, siteConfig } from "../data/site";
---

<BaseLayout
  title="Pilot Assessment | Looptimum"
  description="Assess a Looptimum pilot by defining the evaluation workflow, parameter bounds, resource budget, and acceptance criteria."
  currentPath="/pilot/"
>
  <PageHero
    title="Pilot assessment"
    dek="An initial review establishes whether Looptimum fits your evaluation process. We consider the objective, adjustable parameters, operating environment, and available budget before defining the pilot scope."
    spacedBelow={true}
  />

  <div class="stack-lg">
    <section class="two-column">
      <div class="feature-panel">
        <h2>Project information</h2>
        <p>
          Describe your current evaluation process and the result you want to
          improve. The questions below guide the initial review; estimates
          are sufficient where exact figures are unavailable.
        </p>
        <a class="inline-link" href={repoLinks.intake}>Read the intake notes <span aria-hidden="true">→</span></a>
      </div>
      <div class="question-grid">
        {intakeQuestions.map((question) => (
          <article class="question-card">
            <h3>{question}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="stack-md">
      <div class="section-head">
        <h2>Pilot scope</h2>
        <a class="inline-link" href={repoLinks.pilot}>Read the pilot scope notes <span aria-hidden="true">→</span></a>
      </div>

      <section class="criteria-grid">
        <article class="criteria-card">
          <h3>Evaluation workflow</h3>
          <p>
            Begin with one evaluator, one score, and a small set of parameters
            with defined bounds.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Operating environment</h3>
          <p>
            Evaluations stay in your environment. Identify access restrictions,
            offline requirements, and other operating limits before starting.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Acceptance criteria</h3>
          <p>
            Agree on how to judge a useful result, including any checks beyond
            the optimization score.
          </p>
        </article>
        <article class="criteria-card">
          <h3>Initial review</h3>
          <p>
            Use the initial conversation to review the evaluator, objective,
            and evaluation budget before defining the pilot.
          </p>
        </article>
      </section>
    </section>

    <ActionPanel
      title="Project inquiries"
      body="Email a brief project description and any available details about your evaluation process."
      primaryHref={siteConfig.contactHref}
      primaryLabel="Email Looptimum"
    />
  </div>
</BaseLayout>
