{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngestPayload",
  "type": "object",
  "required": [
    "trial_id",
    "params",
    "objectives"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "trial_id": {
      "type": "integer",
      "minimum": 1
    },
    "params": {
      "type": "object"
    },
    "objectives": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "killed",
        "timeout",
        "success"
      ]
    },
    "penalty_objective": {
      "type": "number"
    },
    "terminal_reason": {
      "type": "string"
    },
    "heartbeat_at": {
      "type": "number"
    },
    "heartbeat_note": {
      "type": "string"
    },
    "heartbeat_meta": {
      "type": "object"
    },
    "objective_sems": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "measurement_sems": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "scalarized_sem": {
      "type": "number",
      "minimum": 0
    }
  }
}
